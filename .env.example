# community-hub — Konfigurationsvorlage
#
# Kopieren nach .env und ausfüllen. .env ist in .gitignore und gehört
# NICHT ins Repository.
#
# Grundregel aus CLAUDE.md: Schlüssel, Relay- und Server-Adressen sind
# Konfiguration, nie Code. Fehlt ein Pflichtwert, bricht der Start ab
# mit klarer Meldung — statt später leere Seiten zu liefern.


# ── Datenquelle (ADR-0012) ──────────────────────────────────────────────
# FOERBICO ist die aktive Quelle. Der Filter nutzt den Autor allein,
# weil 85 von 86 Artikeln kein h-Tag haben — begründete Ausnahme für
# einen redaktionellen Account.
QUELLE_AUTOR=5a12b41ec15b466321e88c371be2dc47d9193f9c8bba4ab09fc50045bd35aedf

# Optionales zweites Kriterium. Leer lassen für FOERBICO.
# Für Bot-Quellen gilt: beide Kriterien zusammen, nie eines allein.
QUELLE_H_TAG=


# ── Relays (ADR-0008, ADR-0013) ─────────────────────────────────────────
# Mehrere Relays sind Pflicht, nicht Redundanz: Der Lizenznachweis liegt
# nicht dort, wo der Artikel liegt.
#
#   relay.edufeed.org      Artikel und Termine
#   relay-rpi.edufeed.org  Lizenznachweise kind:1063
#
# Komma-getrennt. Der Lizenz-Lookup fragt ALLE, nie nur das aus dem naddr.
RELAYS=wss://relay.edufeed.org/,wss://relay-rpi.edufeed.org/


# ── Bilder (ADR-0010) ───────────────────────────────────────────────────
BLOSSOM_URL=https://blossom.edufeed.org/


# ── Entwicklungsserver (SSH) ────────────────────────────────────────────
# Zugang zum Server, auf dem das Schaufenster ausgeliefert wird.
SSH_HOST=
SSH_PORT=22
SSH_USER=

# Pfad zum privaten Schlüssel, z. B. ~/.ssh/id_ed25519
# Schlüssel bevorzugen: Ein Passwort in der .env liegt im Klartext auf
# der Platte und landet in jeder Prozessliste, die es weitergibt.
SSH_KEY=

# Nur falls der Server keine Schlüssel annimmt. Siehe Hinweis bei SSH_KEY.
SSH_PASSWORT=

# Zielverzeichnis auf dem Server
DEPLOY_PFAD=


# ── Umgebung ────────────────────────────────────────────────────────────
# lokal | dev | int
UMGEBUNG=lokal
